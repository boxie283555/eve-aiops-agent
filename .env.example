TZ=Asia/Shanghai

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

AIOPS_DEVICE_USERNAME=
AIOPS_DEVICE_PASSWORD=
AIOPS_DEVICE_SECRET=

AIOPS_SNMP_ENABLED=true
AIOPS_SNMP_COMMUNITY=
AIOPS_SNMP_PORT=161
AIOPS_SNMP_TIMEOUT_SECONDS=3
AIOPS_SNMP_RETRIES=1

# Optional Nautobot integration. Set inventory_source: nautobot in project.yml
# after the Nautobot device inventory has been imported and verified.
NAUTOBOT_URL=
NAUTOBOT_TOKEN=
NAUTOBOT_TIMEOUT_SECONDS=5
AIOPS_INVENTORY_SOURCE=yaml

# Nautobot service (docker-compose.nautobot.yml)
NAUTOBOT_VERSION=2.4.10
NAUTOBOT_PORT=8082
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=
NAUTOBOT_SECRET_KEY=
NAUTOBOT_ALLOWED_HOSTS=*
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.local
NAUTOBOT_SUPERUSER_PASSWORD=
NAUTOBOT_SUPERUSER_API_TOKEN=

TELEGRAF_ENABLE_GNMI=false
TELEGRAF_GNMI_ADDRESSES=
TELEGRAF_GNMI_TCAM_PATHS=
AIOPS_TELEGRAF_METRICS_URL=http://telegraf:9273/metrics

SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM=aiops-agent@example.local
SMTP_TO=
