    {
      "id": 7,
      "title": "软件版本分布 · Software Version Share",
      "type": "bargauge",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "description": "每条横柱代表一个版本的设备数量。未识别表示采集暂未返回版本，不能据此判断设备健康。",
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无数据",
          "mappings": [],
          "unit": "suffix: 台",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "displayName": "${__field.labels.version}"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": false,
        "valueMode": "color",
        "namePlacement": "top",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "sizing": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(sort_desc(count by(version)(label_replace(aiops_device_hardware_info{device=~\"$device\"}, \"version\", \"未识别\", \"version\", \"unknown|^$\")))) and on() (up{job=\"eve-aiops-agent\"} == 1)",
          "refId": "A",
          "legendFormat": "{{version}}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
