    {
      "id": 1,
      "title": "网络运行简报",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无数据",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "### 运行状态 · 资产概况 · 待关注事项\n面向汇报的简明视图。卡片展示所选时间终点的最近采集结果，趋势覆盖右上角所选时段。**设备可达不等于业务可用性。**"
      }
    },
    {
      "id": 2,
      "title": "01  在线设备",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "description": "最近一次设备采集报告的可达数量；采集服务不可用时显示暂无数据。",
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无数据",
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(sum(aiops_device_up{device=~\"$device\"})) and on() (up{job=\"eve-aiops-agent\"} == 1)",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "title": "02  不可达设备",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "description": "大于 0 时请在下方设备清单查看具体设备。不可达不一定代表设备断电。",
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无数据",
          "mappings": [],
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(count(aiops_device_up{device=~\"$device\"}) - sum(aiops_device_up{device=~\"$device\"})) and on() (up{job=\"eve-aiops-agent\"} == 1)",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "title": "03  采集成功率",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "description": "各设备最近一次采集的成功比例；不是时段可用率或业务 SLA。",
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无数据",
          "mappings": [],
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(100 * sum(aiops_collect_success{device=~\"$device\"}) / count(aiops_collect_success{device=~\"$device\"})) and on() (up{job=\"eve-aiops-agent\"} == 1)",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "title": "04  资产同步距今",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 5
      },
      "description": "全局指标，不随设备筛选变化。距最近一次 Nautobot 接口同步成功的时间；超过 5 分钟需关注，15 分钟为红色。无成功记录时显示暂无数据。",
      "fieldConfig": {
        "defaults": {
          "noValue": "暂无数据",
          "mappings": [],
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(time() - (aiops_nautobot_sync_last_success_timestamp_seconds > 0)) and on() (up{job=\"eve-aiops-agent\"} == 1)",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
